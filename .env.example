# ==============================================================================
# APKPipe Environment Configuration Template
# Copy this file to .env and configure your secret tokens and homelab endpoints.
# ==============================================================================

# Core Application Settings
APKPIPE_APP_NAME=APKPipe
APKPIPE_DEBUG=false
APKPIPE_HOST=0.0.0.0
APKPIPE_PORT=8000
APKPIPE_DATABASE_URL=sqlite+aiosqlite:////data/apkpipe.db
APKPIPE_DOWNLOAD_DIR=/downloads
APKPIPE_STAGING_DIR=/data/staging
APKPIPE_POLL_INTERVAL_SECONDS=900

# ------------------------------------------------------------------------------
# Tier 1 Link Resolvers (Peer Debrid Providers)
# ------------------------------------------------------------------------------
# Real-Debrid API Token (https://real-debrid.com/apitoken)
APKPIPE_REAL_DEBRID_API_TOKEN=

# AllDebrid API Key (https://alldebrid.com/apikeys/)
APKPIPE_ALLDEBRID_API_KEY=
APKPIPE_ALLDEBRID_AGENT=apkpipe

# ------------------------------------------------------------------------------
# Tier 2 Link Resolver: JDownloader 2 (Optional Fallback)
# ------------------------------------------------------------------------------
APKPIPE_JDOWNLOADER_EMAIL=
APKPIPE_JDOWNLOADER_PASSWORD=
APKPIPE_JDOWNLOADER_DEVICE_NAME=APKPipe-JD2
APKPIPE_JDOWNLOADER_WATCH_DIR=/data/jd_watch

# ------------------------------------------------------------------------------
# Tier 3: FlareSolverr / Scraper Client (Optional Cloudflare Bypass)
# ------------------------------------------------------------------------------
APKPIPE_SCRAPER_URL=http://scraper:8080

# ------------------------------------------------------------------------------
# Homelab Ingestion & Notifications
# ------------------------------------------------------------------------------
APKPIPE_NEXTCLOUD_URL=http://nextcloud:80
APKPIPE_NEXTCLOUD_TOKEN=
APKPIPE_NEXTCLOUD_OCC_COMMAND=docker exec nextcloud sudo -u abc php /config/www/nextcloud/occ files:scan --path="{path}"

APKPIPE_APPRISE_URL=http://apprise:8000/notify/apprise
APKPIPE_NTFY_TOPIC=apkpipe-alerts
